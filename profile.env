# Dependent total-average-biomass profile configuration.
KFLOW_DOCKER_IMAGE=ghcr.io/pacificcommunity/tuna-flow:v2.5@sha256:c87f1f6d9d4f62dc447844b58afe35f96af175bf933cb6cffbbbe39a59172360
KFLOW_SUBMITTER=suva
KFLOW_SLOT_REQUIREMENTS='regexp("^suvofp", Machine)'
MODEL_SOURCE_REPO=PacificCommunity/ofp-sam-bet-2026-stepwise
MODEL_SOURCE_REF=632bb945d350343b76ec6fba2f95c49a224cb2bb
PROGRAM_PATH=/home/mfcl/mfclo64

# Use the current package snapshots without changing the v2.5 MFCL executable.
KFLOW_RUNTIME_UPDATE=never
TUNA_FLOW_RUNTIME_UPDATE=never
KFLOW_REPO_RUNTIME_UPDATE=always
KFLOW_RUNTIME_PACKAGES=none
KFLOW_REPO_RUNTIME_PACKAGES=FLR4MFCL=PacificCommunity/ofp-sam-flr4mfcl@3faaf84a4867175bfea50d89e4d518c085e84739,mfclkit=PacificCommunity/ofp-sam-mfclkit@25103916446d0395286afae28b5404bf361670fc,mfclshiny=PacificCommunity/mfclshiny@1fc0bb6bf4cf5349da6f6def54cc56c5a60e182a
MFCLKIT_GITHUB_REF=25103916446d0395286afae28b5404bf361670fc
MFCLSHINY_GITHUB_REF=1fc0bb6bf4cf5349da6f6def54cc56c5a60e182a

PROFILE_TYPE=quantity
PROFILE_NAME=total_average_biomass
PROFILE_QUANTITY=avg_bio
PROFILE_VALUE_MODE=percent
PROFILE_CENTER=100
PROFILE_INCLUDE_BASE_ANCHOR=true
PROFILE_VALUES="60 62.5 65 67.5 70 72.5 75 77.5 80 82.5 85 87.5 90 92.5 95 97.5 100 102.5 105 107.5 110 112.5 115 117.5 120 122.5 125 127.5 130 132.5 135 137.5 140"

# Two continuation chains use the fitted model as their dependency.
PROFILE_PRESET=robust_fast
PROFILE_STYLE=robust_fast
PROFILE_PARALLEL_MODE=chains
PROFILE_EXECUTION_MODE=continuation
PROFILE_CONVERGENCE_EXPONENT=-3
PROFILE_CONTINUATION_REPS=1000
PROFILE_TARGET_REL_TOLERANCE=0.001
PROFILE_RETRY_INVALID=true
PROFILE_INVALID_RETRY_PASSES=1

# Merge and attach the completed profile to the fitted parent model.
KFLOW_PARALLEL_UNITS=true
KFLOW_AUTO_MERGE=true
KFLOW_AUTO_ATTACH=true
ATTACH_OUTPUT_MODE=delta

# Do not retry or repair jagged points.
PROFILE_RETRY_JAGGED=false
PROFILE_UNIT_RETRY_JAGGED=false
PROFILE_REVERSE_ONCE=false
PROFILE_UNIT_REVERSE_ONCE=false
PROFILE_JAGGED_REPAIR_PASSES=0
PROFILE_UNIT_JAGGED_REPAIR_PASSES=0
PROFILE_MAX_JAGGED_REPAIRS=0
PROFILE_UNIT_MAX_JAGGED_REPAIRS=0
PROFILE_POST_MERGE_REPAIR=false
